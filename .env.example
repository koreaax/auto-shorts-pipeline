# ==========================================
# NEXT.JS AI SAAS STARTER - ENVIRONMENT VARIABLES
# ==========================================

# 1. OPENAI API KEY (Required)
# Get yours from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# 2. SUPABASE AUTH & DB (Required)
# Get yours from: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. LEMON SQUEEZY / STRIPE PAYMENTS (Optional for dev, required for prod)
# Lemon Squeezy: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key-here
LEMONSQUEEZY_STORE_ID=your-store-id-here
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret-here

# 4. YOUTUBE PIPELINE (Required for auto-upload)
# Step 1: Google Cloud Console → APIs & Services → Credentials → Create OAuth2 Client (Desktop App)
# Step 2: Run initial auth once to get refresh_token
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret-here
YOUTUBE_REFRESH_TOKEN=your-refresh-token-here  # 영구적, 만료 없음

# 5. PEXELS (Required for background images)
# Get yours from: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# 6. TISTORY BLOG AUTO-POSTING
TISTORY_KAKAO_EMAIL=your-kakao-email@example.com
TISTORY_KAKAO_PASSWORD=your-kakao-password-here
TISTORY_BLOG_NAME=your-tistory-blog-name
COUPANG_AFFILIATE_LINK=https://link.coupang.com/your-affiliate-link

# 7. APP CONFIGURATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
